{
  "name": "smart-home-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first smart-home management prototype with simulated devices, PostgreSQL persistence and AI-assisted support.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx server/scripts/seed.ts",
    "db:reset": "tsx server/scripts/seed.ts --reset",
    "dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false --ignore \"client/**\" server/index.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && tsx server/scripts/migrate.ts --test && playwright test",
    "build": "vite build && esbuild server/index.ts --platform=node --bundle --format=esm --packages=external --target=node22 --outfile=dist/index.js",
    "start": "cross-env NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "cross-env": "10.1.0",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "openai": "7.32.0",
    "pg": "8.23.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lucide-react": "1.55.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wouter": "3.13.0"
  }
}
