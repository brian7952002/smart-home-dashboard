          "name": "devices_error_consistency",
          "value": "(\"devices\".\"has_error\" AND \"devices\".\"error_message\" IS NOT NULL) OR (NOT \"devices\".\"has_error\" AND \"devices\".\"error_message\" IS NULL AND NOT \"devices\".\"error_fixable\")"
