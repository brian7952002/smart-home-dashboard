# Copy to .env and adjust. Never commit real credentials.
# The postgres:postgres credentials match the local docker-compose container only.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smarthome
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/smarthome_test
PORT=5000
# Optional. Without a key the app uses built-in offline guidance.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_RATE_LIMIT_PER_MIN=20
# Registers /api/devices/:id/simulate-error and /api/demo/reset. Keep false anywhere shared.
ENABLE_DEMO_ENDPOINTS=true
SEED_ON_START=true
